# ---------------------------------------------------------------------------
# CRM Backend - environment configuration (EXAMPLE / placeholders only).
#
# Copy this file to `.env` and fill in real values. NEVER commit the real
# `.env` file - it is gitignored and contains secrets.
# ---------------------------------------------------------------------------

# Port the server listens on. Render injects this automatically.
PORT=5000

# MongoDB connection string (MongoDB Atlas).
# Replace with your real Atlas URI. Never use the value below in production.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crm?retryWrites=true&w=majority

# JWT signing secret. MUST be a long, random, high-entropy string in
# production (e.g. `openssl rand -hex 64`). Never reuse a dev placeholder.
JWT_SECRET=change_me_to_a_long_random_secret

# Optional. Comma-separated list of browser origins allowed to call this API
# (HTTP + Socket.IO). Use EXACT origins with scheme+host+port, no trailing
# slash. Example: https://app.example.com,http://localhost:5173
# When unset/empty, all origins are allowed (development convenience only).
FRONTEND_URL=
